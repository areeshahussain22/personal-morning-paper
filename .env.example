APP_ENV=development
APP_NAME=Personal Morning Paper
LOG_LEVEL=INFO
DATABASE_PATH=data/personal_morning_paper.db
FRESHNESS_HOURS=48
RSS_TIMEOUT_SECONDS=15
RSS_MAX_RETRIES=2
RSS_MAX_CONCURRENT_FEEDS=4
RECOMMENDATION_EDITION_SIZE=10
TOPIC_MATCH_THRESHOLD=0.12
EMBEDDING_DIMENSIONS=64
EMBEDDING_BACKEND=sentence_transformer
EMBEDDING_ALLOW_FALLBACK=false
EMBEDDING_DEVICE=cpu
CLUSTER_WINDOW_HOURS=36
CLUSTER_SIMILARITY_THRESHOLD=0.72
HASHED_CLUSTER_SIMILARITY_THRESHOLD=0.45
REAL_TOPIC_MATCH_THRESHOLD=0.10
TOPIC_SECONDARY_MARGIN=0.04
LLM_PROVIDER_ORDER=gemini,groq,openrouter,ollama
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_CONCURRENCY_LIMIT=2
LLM_MIN_PROVIDER_INTERVAL=0
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_MODEL=meta-llama/llama-3.3-8b-instruct:free
OLLAMA_MODEL=llama3.2
ENVIRONMENT=development
SESSION_SECRET=
PDF_RENDERER=auto
PUBLIC_BASE_URL=http://localhost:8000
