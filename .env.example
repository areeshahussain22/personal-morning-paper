APP_ENV=development
APP_NAME=Personal Morning Paper
LOG_LEVEL=INFO
DATABASE_PATH=data/personal_morning_paper.db
FRESHNESS_HOURS=48
RSS_TIMEOUT_SECONDS=15
RSS_MAX_RETRIES=2
RSS_MAX_CONCURRENT_FEEDS=4
RECOMMENDATION_EDITION_SIZE=10
TOPIC_MATCH_THRESHOLD=0.12
EMBEDDING_DIMENSIONS=64
EMBEDDING_BACKEND=sentence_transformer
EMBEDDING_ALLOW_FALLBACK=false
EMBEDDING_DEVICE=cpu
CLUSTER_WINDOW_HOURS=36
CLUSTER_SIMILARITY_THRESHOLD=0.72
HASHED_CLUSTER_SIMILARITY_THRESHOLD=0.45
REAL_TOPIC_MATCH_THRESHOLD=0.45
